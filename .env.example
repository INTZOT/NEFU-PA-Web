# ============================================================
# 环境变量样板
# 使用方法：复制为 .env 并填入真实值（.env 不进仓库）
# ============================================================

# ---------- 域名 ----------
# Caddy 会为此域名自动申请并续期 HTTPS 证书。
# 解析要求：该域名的 A 记录需指向本服务器公网 IP。
SITE_DOMAIN=pickle.example.com

# ---------- 数据库 ----------
# 超级管理员账号，仅容器网络内可达，不对公网暴露端口。
POSTGRES_USER=nefu
POSTGRES_PASSWORD=请替换为强密码
POSTGRES_DB=nefu_pa

# 机器人使用的受限数据库账号（D-19 要求：绝不能用管理员账号）。
# 阶段 1 尚未创建该账号，先留空占位；
# 阶段 3 接入机器人时会补充建号脚本与最小权限授予。
BOT_DB_USER=nefu_bot
BOT_DB_PASSWORD=请替换为另一个强密码

# ---------- 会话 ----------
# 用于登录态签名，请使用足够长的随机串。
# 生成方式示例：openssl rand -base64 48
SESSION_SECRET=请替换为随机长串

# ---------- 机器人 ----------
# OneBot 协议端（NapCat）的 WebSocket 地址，容器网络内解析。
ONEBOT_WS_URL=ws://napcat:3001
# 共享规则接口：密码加密与邀请码生成的唯一实现位于网站侧。
SHARED_RULES_URL=http://web:3000/api/internal/shared-rules
# 该接口的访问令牌。一旦泄露，等同可以重置任意账号密码。
# 生成方式示例：openssl rand -base64 36
SHARED_RULES_TOKEN=请替换为随机长串

# ---------- 超级管理员初始化 ----------
# 决策 D-23 要求超管「预先指定」，而非靠注册顺序自动产生。
# 阶段 2 的初始化脚本会按此 QQ 号创建（或提升）超级管理员账号。
SUPER_ADMIN_QQ=

# ---------- NapCat（QQ 协议端）----------
# 容器内以该 UID/GID 运行，需与宿主机挂载目录属主一致。
NAPCAT_UID=1000
NAPCAT_GID=1000
